{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Everything Player",
  "version": "0.1.0",
  "identifier": "com.everythingplayer.client",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:tauri"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Everything Player",
        "width": 1000,
        "height": 760,
        "minWidth": 420,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "fullscreen": false,
        "maximized": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Everything Player Project",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
